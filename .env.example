# Copiar estos valores en Vercel → Settings → Environment Variables.
# Para probar en local, copiar este archivo como .env.local (está en .gitignore).

# Clave de Resend, el servicio que envía el correo del formulario.
# Se saca en resend.com → API Keys. Sin esta variable el formulario sigue
# funcionando, pero cae al método anterior (abrir WhatsApp).
RESEND_API_KEY=

# Casilla que recibe los leads. Si se deja vacío usa el correo de content/site.ts
CONTACTO_TO=info@thermobus.com.co

# Remitente. Mientras el dominio no esté verificado en Resend, dejar el de
# pruebas: solo entrega al correo con el que se creó la cuenta de Resend.
# Con el dominio verificado, cambiar a: Thermobus <no-responder@thermobus.com.co>
CONTACTO_FROM=Thermobus <onboarding@resend.dev>
